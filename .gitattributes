# Files that run inside Linux containers must keep LF line endings. Git for
# Windows would otherwise check them out as CRLF (core.autocrlf=true), which
# breaks the container with "exec ... failed: No such file or directory"
# (exit 127) because the shebang becomes "#!/bin/sh\r".
Dockerfile              text eol=lf
**/Dockerfile           text eol=lf
*.sh                    text eol=lf
**/*.sh                 text eol=lf
sample-data/**          text eol=lf
docker-compose*.yml     text eol=lf
.env.example            text eol=lf
*.patch                text eol=lf
